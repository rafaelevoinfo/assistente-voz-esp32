(export (version "E")
  (design (source "netlist.py") (tool "netlist.py"))
  (components
    (comp (ref "U1") (value "YD-ESP32-S3") (footprint "assistente:YD_ESP32_S3_Soquete"))
    (comp (ref "U2") (value "INMP441") (footprint "assistente:INMP441_Soquete"))
    (comp (ref "U3") (value "MAX98357A") (footprint "assistente:MAX98357A_Soquete"))
    (comp (ref "RV1") (value "B10K WH148") (footprint "assistente:WH148_Horizontal"))
    (comp (ref "C1") (value "470-1000uF 10V") (footprint "Capacitor_THT:CP_Radial_D10.0mm_P5.00mm"))
    (comp (ref "C2") (value "470-1000uF 10V") (footprint "Capacitor_THT:CP_Radial_D10.0mm_P5.00mm"))
    (comp (ref "JP1") (value "GANHO 9/12/15dB") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x03_P2.54mm_Vertical"))
    (comp (ref "R1") (value "100k") (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P7.62mm_Horizontal"))
  )
  (nets
    (net (code "1") (name "/+3V3")
      (node (ref "U1") (pin "1") (pinfunction "3V3"))
      (node (ref "U2") (pin "1") (pinfunction "VDD"))
      (node (ref "RV1") (pin "1") (pinfunction "1"))
    )
    (net (code "2") (name "/GND")
      (node (ref "U1") (pin "22") (pinfunction "GND"))
      (node (ref "U2") (pin "2") (pinfunction "GND"))
      (node (ref "U2") (pin "3") (pinfunction "L/R"))
      (node (ref "U3") (pin "6") (pinfunction "GND"))
      (node (ref "RV1") (pin "3") (pinfunction "3"))
      (node (ref "C1") (pin "2") (pinfunction "-"))
      (node (ref "C2") (pin "2") (pinfunction "-"))
      (node (ref "JP1") (pin "1") (pinfunction "1"))
      (node (ref "R1") (pin "2") (pinfunction "2"))
    )
    (net (code "3") (name "/+5V")
      (node (ref "U1") (pin "21") (pinfunction "5Vin"))
      (node (ref "U3") (pin "7") (pinfunction "VIN"))
      (node (ref "C1") (pin "1") (pinfunction "+"))
      (node (ref "C2") (pin "1") (pinfunction "+"))
    )
    (net (code "4") (name "/I2S_WS")
      (node (ref "U1") (pin "4") (pinfunction "4"))
      (node (ref "U2") (pin "4") (pinfunction "WS"))
    )
    (net (code "5") (name "/I2S_SCK")
      (node (ref "U1") (pin "5") (pinfunction "5"))
      (node (ref "U2") (pin "5") (pinfunction "SCK"))
    )
    (net (code "6") (name "/I2S_SD")
      (node (ref "U1") (pin "12") (pinfunction "8"))
      (node (ref "U2") (pin "6") (pinfunction "SD"))
    )
    (net (code "7") (name "/AMP_LRC")
      (node (ref "U1") (pin "6") (pinfunction "6"))
      (node (ref "U3") (pin "1") (pinfunction "LRC"))
    )
    (net (code "8") (name "/AMP_BCLK")
      (node (ref "U1") (pin "7") (pinfunction "7"))
      (node (ref "U3") (pin "2") (pinfunction "BCLK"))
    )
    (net (code "9") (name "/AMP_DIN")
      (node (ref "U1") (pin "15") (pinfunction "9"))
      (node (ref "U3") (pin "3") (pinfunction "DIN"))
    )
    (net (code "10") (name "/VOL")
      (node (ref "U1") (pin "16") (pinfunction "10"))
      (node (ref "RV1") (pin "2") (pinfunction "2"))
    )
    (net (code "11") (name "/GAIN")
      (node (ref "U3") (pin "4") (pinfunction "GAIN"))
      (node (ref "JP1") (pin "2") (pinfunction "2"))
    )
    (net (code "12") (name "/GAIN_15DB")
      (node (ref "JP1") (pin "3") (pinfunction "3"))
      (node (ref "R1") (pin "1") (pinfunction "1"))
    )
  )
)
