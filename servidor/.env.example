# Copie para .env (nunca commite o .env). No Dokploy, cadastre estas variáveis na UI.

# Token secreto da placa (32+ caracteres aleatórios). O mesmo vai no firmware/config.h.
TOKEN_PLACA=troque-por-um-token-aleatorio-de-32-caracteres

# Provedor de voz: gemini (padrão) ou openai
PROVEDOR_VOZ=gemini
GOOGLE_API_KEY=
# OPENAI_API_KEY=           # só se PROVEDOR_VOZ=openai

# Modelos e voz (vazio = default de voz/config.py). Os modelos Live mudam com frequência.
MODELO_VOZ=models/gemini-3.8-live
VOZ=Charon
MODELO_TTS=gemini-3.8-flash-lite-tts
# VOZ_TTS=Charon
# PROACTIVE_AUDIO=1         # 0 desliga (modelos que não suportam)
# Busca no Google (ferramenta nativa do Gemini): true liga, false desliga
BUSCA_GOOGLE=true

# Janela de continuação e espera pela resposta do modelo (segundos)
JANELA_CONTINUACAO_S=8
ESCUTA_MAX_S=60
ESPERA_RESPOSTA_S=6

# Memória do assistente: historico.jsonl (automático). As instruções ficam em INSTRUCTIONS.md.
# Vazio = sem memória. No container fica dentro do volume /home/voz.
MEMORIA_DIR=/home/voz/memoria

# Claude Code
WORKSPACE_DIR=/home/voz/workspace
CLAUDE_TIMEOUT_S=1800
CLAUDE_CODE_OAUTH_TOKEN=     # gerado com "claude setup-token"
# CLAUDE_CMD=claude          # testes locais: "python tests/fake_claude.py"

# GitHub (clone, branches, PRs)
GH_TOKEN=

LOG_LEVEL=INFO
